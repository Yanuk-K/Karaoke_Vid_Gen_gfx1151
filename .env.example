# OpenAI API Key (required for OpenAI Whisper transcription)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Whisper.cpp settings (required for whisper.cpp transcription)
# WHISPER_CPP_BIN=/path/to/whisper.cpp
# WHISPER_CPP_MODEL=/path/to/whisper-model.bin

# Qwen3-ASR settings (local model at models/qwen3-asr-1.7b)
# QWEN_ASR_MODEL_PATH=/path/to/qwen3-asr-model
# Leave unset to auto-download Qwen/Qwen3-ASR-1.7B from HuggingFace Hub

# BS-RoFormer model paths (optional - defaults to project paths)
# UVR_REPO_PATH=/
# UVR_BSROFORMER_CKPT=/path/to/model_bs_roformer_ep_317_sdr_12.9755.ckpt
# UVR_BSROFORMER_YAML=/path/to/model_bs_roformer_ep_317_sdr_12.9755.yaml
